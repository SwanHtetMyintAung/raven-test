#include <windows.h>

// --------------------------------------------------
// Application icon
// --------------------------------------------------
IDI_ICON1 ICON "app.ico"


// --------------------------------------------------
// Version information
// --------------------------------------------------
VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1,0,0,0
    PRODUCTVERSION 1,0,0,0

    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // English (United States), Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ThaKhinSoe Enterprise\0"
            VALUE "FileDescription", "Kanji Flash Card\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "Avalanche\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 SoeTheGreat & Tom Rudy\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "Kanji Review.exe\0"
            VALUE "ProductName", "Kanji Reviewer\0"
            VALUE "ProductVersion", "1.0.0.0\0"
            VALUE "Comments", "A program that review N3 kanjis.\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
