<Window Title="FlashCard" Width="520" Height="360">
	<VBox Spacing="8" Height="844" Color.Window="#000">
		<HBox>
			<Button Text="☰ Chapters" Slot.Padding="10" MinWidth="200" OnClicked="chapter_menu.toggle"/>
			<Spacer Width="16" Height="16" Slot.Fill="2"/>
			<Button Text="Save" Width="100" Slot.Padding="10" MinWidth="200"/>
		</HBox>
		<Overlay Slot.Fill="2">
			<Grid Spacing="8" Columns="1" Rows="2" Slot.Fill="2">
				<Label Text="Kanji" Slot.Row="0" TextSize="100" Name="kanji" TextAlign="Center" Slot.VAlign="Center"/>
				<Label Width="100" Text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since 1966, when designers " Slot.Row="1" Height="500" Wrap="true" TextSize="20" TextAlign="Center" Slot.Padding="10"/>
			</Grid>
			<ScrollBox Slot.HAlign="Left" Material="Solid" Width="400" Spacing="0" ScrollBoth="false" Orientation="Vertical" Slot.Padding="10,0" Slot.VAlign="Top">
				<Menu Text="Menu" Material="Glass" Metric.FontSize="24" Metric.RowHeight="40" Name="chapter_menu" Visibility="Collapsed">
					<MenuItem Text="Item"/>
					<MenuItem Text="Item"/>
					<MenuItem Text="Item"/>
					<MenuItem Text="Item"/>
					<MenuItem Text="Item"/>
					<MenuItem Text="Item"/>
				</Menu>
			</ScrollBox>
		</Overlay>
		<Switcher Index="0" Slot.VAlign="Bottom" Name="button_switcher">
			<Button Text="Reveal" Height="50" OnClicked="switcher.index.1"/>
			<UniformGrid Columns="2">
				<Button Text="Previous" Height="50" Text="Previous" OnClicked="switcher.index.0"/>
				<Button Text="Next" Height="50" Text="Next" OnClicked="switcher.index.0"/>
			</UniformGrid>
		</Switcher>
	</VBox>
</Window>
